# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SERVER-SIDE SIGNING SECRET (Used for guest session HMAC and time-limited media playback URLs)
# If not set, the server automatically derives a runtime signing key.
SESSION_SIGNING_SECRET="replace-with-random-32-byte-hex-secret"

# FREE-TIER OPERATIONAL LIMITS
MAX_ROOM_PARTICIPANTS="8"
RECOMMENDED_VOICE_PARTICIPANTS="4"
MAX_UPLOAD_FILE_SIZE_MB="50"
MAX_CHAT_MESSAGE_LENGTH="500"
IDLE_ROOM_EXPIRY_MINUTES="120"
